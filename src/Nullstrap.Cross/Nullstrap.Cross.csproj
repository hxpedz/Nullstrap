<Project Sdk="LibreWPF.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<StartupObject>Nullstrap.Program</StartupObject>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
		<PublishTrimmed>false</PublishTrimmed>
		<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
		<ProGpuWpfSystemFormatsNrbfVersion>10.0.13</ProGpuWpfSystemFormatsNrbfVersion>
		<BaseOutputPath Condition="'$(RuntimeIdentifier)' != '' And '$(NullstrapLinuxPackagingRoot)' == ''">bin-$(RuntimeIdentifier)\</BaseOutputPath>
		<AssemblyName>Nullstrap</AssemblyName>
		<RootNamespace>Nullstrap</RootNamespace>
		<EnableDefaultItems>false</EnableDefaultItems>
		<DefineConstants>$(DefineConstants);CROSSPLAT</DefineConstants>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ProGpuWpfUsePortableFrameworkReferences>true</ProGpuWpfUsePortableFrameworkReferences>
		<ProGpuWpfSystemSecurityCryptographyXmlVersion>10.0.13</ProGpuWpfSystemSecurityCryptographyXmlVersion>
		<ProGpuWpfUsePortableWinFormsCompat>false</ProGpuWpfUsePortableWinFormsCompat>
		<ProGpuWpfUseLibreWinForms>false</ProGpuWpfUseLibreWinForms>
		<NoWarn>$(NoWarn);CS8305</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
		<PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">true</PublishReadyToRun>
		<TieredPGO>false</TieredPGO>
		<LinuxProGpuWpfAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\ProGPU.Wpf.dll</LinuxProGpuWpfAssembly>
		<LinuxPresentationCoreAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\PresentationCore.dll</LinuxPresentationCoreAssembly>
		<LinuxPresentationFrameworkAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\PresentationFramework.dll</LinuxPresentationFrameworkAssembly>
	</PropertyGroup>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
		<PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">true</PublishReadyToRun>
		<TieredPGO>false</TieredPGO>
		<LinuxProGpuWpfAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\ProGPU.Wpf.dll</LinuxProGpuWpfAssembly>
		<LinuxPresentationCoreAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\PresentationCore.dll</LinuxPresentationCoreAssembly>
		<LinuxPresentationFrameworkAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\PresentationFramework.dll</LinuxPresentationFrameworkAssembly>
		<LinuxWgpuLibrary>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\$(RuntimeIdentifier)\libwgpu_native.so</LinuxWgpuLibrary>
		<LinuxGlfwLibrary>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\$(RuntimeIdentifier)\libglfw.so.3</LinuxGlfwLibrary>
	</PropertyGroup>

	<ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) And Exists('$(MSBuildProjectDirectory)\..\..\external\LibreWPF\$(RuntimeIdentifier)\libwgpu_native_gl.so')">
		<None Include="$(MSBuildProjectDirectory)\..\..\external\LibreWPF\$(RuntimeIdentifier)\libwgpu_native_gl.so">
			<Link>libwgpu_native_gl.so</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
		<LinuxEditorCompatLibrary>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\libnullstrapeditorcompat.so</LinuxEditorCompatLibrary>
		<LinuxEditorCompatLibrary Condition="$(RuntimeIdentifier.EndsWith('-arm64'))">$(MSBuildProjectDirectory)\..\..\external\LibreWPF\linux-arm64\libnullstrapeditorcompat.so</LinuxEditorCompatLibrary>
		<LinuxEditorCompatLibrary Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(BaseIntermediateOutputPath)editorcompat/$(RuntimeIdentifier)/libnullstrapeditorcompat.so</LinuxEditorCompatLibrary>
	</PropertyGroup>

	<Target Name="BuildLinuxEditorCompat" BeforeTargets="PrepareForBuild" Condition="$(RuntimeIdentifier.StartsWith('linux')) And $([MSBuild]::IsOSPlatform('Linux'))" Inputs="$(MSBuildProjectDirectory)/../../build/Packaging/Linux/editor-compat.c;$(MSBuildProjectDirectory)/../../build/Packaging/Linux/build-native-compat.sh" Outputs="$(LinuxEditorCompatLibrary)">
		<Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/Packaging/Linux/build-native-compat.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(LinuxEditorCompatLibrary)&quot;" />
	</Target>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('osx'))">
		<NullImageFileName Condition="$(RuntimeIdentifier.StartsWith('linux'))">libnullimage.so</NullImageFileName>
		<NullImageFileName Condition="$(RuntimeIdentifier.StartsWith('osx'))">libnullimage.dylib</NullImageFileName>
		<NullImageLibrary>$(BaseIntermediateOutputPath)nullimage/$(RuntimeIdentifier)/$(NullImageFileName)</NullImageLibrary>
	</PropertyGroup>

	<Target Name="BuildNullImage" BeforeTargets="AssignTargetPaths" Condition="'$(NullImageLibrary)' != '' And '$(DesignTimeBuild)' != 'true' And !$([MSBuild]::IsOSPlatform('Windows'))" Inputs="$(MSBuildProjectDirectory)/../../native/nullimage/Cargo.toml;$(MSBuildProjectDirectory)/../../native/nullimage/Cargo.lock;@(NullImageSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-nullimage.sh" Outputs="$(NullImageLibrary)">
		<Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/Packaging/build-nullimage.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(NullImageLibrary)&quot; &quot;$(BaseIntermediateOutputPath)nullimage/target&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) And $([MSBuild]::IsOSPlatform('Windows'))">
		<NullstrapWslDistro Condition="'$(NullstrapWslDistro)' == ''">Ubuntu</NullstrapWslDistro>
		<_NullImageRootWin>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../'))</_NullImageRootWin>
		<_NullImageLibraryWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(NullImageLibrary)'))))</_NullImageLibraryWin>
		<_NullImageTargetWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)nullimage/target'))))</_NullImageTargetWin>
		<_NullImageRootWsl>/mnt/$(_NullImageRootWin.Substring(0, 1).ToLowerInvariant())$(_NullImageRootWin.Substring(2).Replace('%5C', '/'))</_NullImageRootWsl>
		<_NullImageLibraryWsl>/mnt/$(_NullImageLibraryWin.Substring(0, 1).ToLowerInvariant())$(_NullImageLibraryWin.Substring(2).Replace('%5C', '/'))</_NullImageLibraryWsl>
		<_NullImageTargetWsl>/mnt/$(_NullImageTargetWin.Substring(0, 1).ToLowerInvariant())$(_NullImageTargetWin.Substring(2).Replace('%5C', '/'))</_NullImageTargetWsl>
	</PropertyGroup>

	<Target Name="BuildNullImageThroughWsl" BeforeTargets="AssignTargetPaths" Condition="$(RuntimeIdentifier.StartsWith('linux')) And '$(DesignTimeBuild)' != 'true' And $([MSBuild]::IsOSPlatform('Windows'))" Inputs="$(MSBuildProjectDirectory)/../../native/nullimage/Cargo.toml;$(MSBuildProjectDirectory)/../../native/nullimage/Cargo.lock;@(NullImageSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-nullimage.sh" Outputs="$(NullImageLibrary)">
		<Exec Command="wsl.exe -d $(NullstrapWslDistro) -e bash &quot;$(_NullImageRootWsl)build/Packaging/build-nullimage.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(_NullImageLibraryWsl)&quot; &quot;$(_NullImageTargetWsl)&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<Target Name="RequireLinuxNullImage" DependsOnTargets="BuildNullImage;BuildNullImageThroughWsl" BeforeTargets="AssignTargetPaths" Condition="$(RuntimeIdentifier.StartsWith('linux')) And '$(DesignTimeBuild)' != 'true' And '$(NullstrapAllowMissingNullImage)' != 'true'">
		<Error Condition="!Exists('$(NullImageLibrary)')" Text="libnullimage.so was not built for $(RuntimeIdentifier). Linux builds cannot show any image without it. Install Rust (and WSL with Rust when building on Windows), or set NullstrapAllowMissingNullImage=true to build anyway." />
	</Target>

	<ItemGroup>
		<NullImageSources Include="$(MSBuildProjectDirectory)/../../native/nullimage/src/**/*.rs" />
	</ItemGroup>

	<Target Name="IncludeNullImage" DependsOnTargets="BuildNullImage;BuildNullImageThroughWsl;RequireLinuxNullImage" BeforeTargets="AssignTargetPaths" Condition="'$(NullImageLibrary)' != ''">
		<ItemGroup>
			<None Condition="Exists('$(NullImageLibrary)')" Include="$(NullImageLibrary)" Link="$(NullImageFileName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64'">
		<NullLayerLibrary>$(BaseIntermediateOutputPath)nulllayer/$(RuntimeIdentifier)/libnullstrap_overlay.so</NullLayerLibrary>
	</PropertyGroup>

	<Target Name="BuildNullLayer" BeforeTargets="AssignTargetPaths;PrepareResources" Condition="'$(NullLayerLibrary)' != '' And '$(DesignTimeBuild)' != 'true' And !$([MSBuild]::IsOSPlatform('Windows'))" Inputs="$(MSBuildProjectDirectory)/../../native/nulllayer/nullstrap_overlay.c;$(MSBuildProjectDirectory)/../../native/nulllayer/shaders.h;$(MSBuildProjectDirectory)/../../build/Packaging/build-nulllayer.sh" Outputs="$(NullLayerLibrary)">
		<Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/Packaging/build-nulllayer.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(NullLayerLibrary)&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<Target Name="IncludeNullLayer" DependsOnTargets="BuildNullLayer" BeforeTargets="AssignTargetPaths;PrepareResources" Condition="'$(NullLayerLibrary)' != ''">
		<ItemGroup>
			<EmbeddedResource Condition="Exists('$(NullLayerLibrary)')" Include="$(NullLayerLibrary)" LogicalName="Nullstrap.Resources.Linux.libnullstrap_overlay.so" />
		</ItemGroup>
	</Target>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('osx'))">
		<NullClipFileName Condition="$(RuntimeIdentifier.StartsWith('linux'))">libnullclip.so</NullClipFileName>
		<NullClipFileName Condition="$(RuntimeIdentifier.StartsWith('osx'))">libnullclip.dylib</NullClipFileName>
		<NullClipLibrary>$(BaseIntermediateOutputPath)nullclip/$(RuntimeIdentifier)/$(NullClipFileName)</NullClipLibrary>
	</PropertyGroup>

	<ItemGroup>
		<NullClipSources Include="$(MSBuildProjectDirectory)/../../native/nullclip/src/**/*.rs" />
	</ItemGroup>

	<Target Name="BuildNullClip" BeforeTargets="AssignTargetPaths" Condition="'$(NullClipLibrary)' != '' And '$(DesignTimeBuild)' != 'true' And !$([MSBuild]::IsOSPlatform('Windows'))" Inputs="$(MSBuildProjectDirectory)/../../native/nullclip/Cargo.toml;$(MSBuildProjectDirectory)/../../native/nullclip/Cargo.lock;@(NullClipSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-nullclip.sh" Outputs="$(NullClipLibrary)">
		<Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/Packaging/build-nullclip.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(NullClipLibrary)&quot; &quot;$(BaseIntermediateOutputPath)nullclip/target&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) And $([MSBuild]::IsOSPlatform('Windows'))">
		<_NullClipLibraryWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(NullClipLibrary)'))))</_NullClipLibraryWin>
		<_NullClipTargetWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)nullclip/target'))))</_NullClipTargetWin>
		<_NullClipLibraryWsl>/mnt/$(_NullClipLibraryWin.Substring(0, 1).ToLowerInvariant())$(_NullClipLibraryWin.Substring(2).Replace('%5C', '/'))</_NullClipLibraryWsl>
		<_NullClipTargetWsl>/mnt/$(_NullClipTargetWin.Substring(0, 1).ToLowerInvariant())$(_NullClipTargetWin.Substring(2).Replace('%5C', '/'))</_NullClipTargetWsl>
	</PropertyGroup>

	<Target Name="BuildNullClipThroughWsl" BeforeTargets="AssignTargetPaths" Condition="$(RuntimeIdentifier.StartsWith('linux')) And '$(DesignTimeBuild)' != 'true' And $([MSBuild]::IsOSPlatform('Windows'))" Inputs="$(MSBuildProjectDirectory)/../../native/nullclip/Cargo.toml;$(MSBuildProjectDirectory)/../../native/nullclip/Cargo.lock;@(NullClipSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-nullclip.sh" Outputs="$(NullClipLibrary)">
		<Exec Command="wsl.exe -d $(NullstrapWslDistro) -e bash &quot;$(_NullImageRootWsl)build/Packaging/build-nullclip.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(_NullClipLibraryWsl)&quot; &quot;$(_NullClipTargetWsl)&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<Target Name="IncludeNullClip" DependsOnTargets="BuildNullClip;BuildNullClipThroughWsl" BeforeTargets="AssignTargetPaths" Condition="'$(NullClipLibrary)' != ''">
		<ItemGroup>
			<None Condition="Exists('$(NullClipLibrary)')" Include="$(NullClipLibrary)" Link="$(NullClipFileName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
		<None Include="$(MSBuildProjectDirectory)\..\..\external\LibreWPF\GLFW-LICENSE.txt" Condition="Exists('$(LinuxGlfwLibrary)')">
			<Link>GLFW-LICENSE.txt</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Include="$(LinuxEditorCompatLibrary)">
			<Link>libnullstrapeditorcompat.so</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
		<None Include="$(MSBuildProjectDirectory)\..\..\external\LibreWPF\osx\libnullstrapeditorcompat.dylib">
			<Link>libnullstrapeditorcompat.dylib</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('osx'))">
		<None Include="$(MSBuildProjectDirectory)\..\..\external\LibreWPF\System.Windows.Forms.dll">
			<Link>System.Windows.Forms.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<Target Name="BundleManagedTransportAssets" BeforeTargets="_ComputeFilesToBundle" DependsOnTargets="_ProGpuWpfSdkPublishManagedTransportRuntimeAssets" Condition="'$(PublishSingleFile)' == 'true'" />

	<ItemGroup>
		<TrimmerRootAssembly Include="Nullstrap" />
		<TrimmerRootAssembly Include="PresentationFramework" />
		<TrimmerRootAssembly Include="PresentationCore" />
		<TrimmerRootAssembly Include="PresentationUI" />
		<TrimmerRootAssembly Include="WindowsBase" />
		<TrimmerRootAssembly Include="System.Xaml" />
		<TrimmerRootAssembly Include="UIAutomationProvider" />
		<TrimmerRootAssembly Include="UIAutomationTypes" />
		<TrimmerRootAssembly Include="Wpf.Ui" />
		<TrimmerRootAssembly Include="Newtonsoft.Json" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="*.cs" />
		<Compile Visible="false" Include="..\Nullstrap.App\**\*.cs" Exclude="..\Nullstrap.App\obj\**;..\Nullstrap.App\obj-*\**;..\Nullstrap.App\bin\**;..\Nullstrap.App\bin-*\**;..\Nullstrap.App\UI\Elements\RobloxWeb\**;..\Nullstrap.App\UI\Elements\Controls\InlineVideoPlayer.xaml.cs;..\Nullstrap.App\UI\Elements\ContextMenu\Web\**;..\Nullstrap.App\UI\Elements\Bootstrapper\ProgressDialog*.cs;..\Nullstrap.App\UI\Elements\Bootstrapper\LegacyDialog*.cs;..\Nullstrap.App\UI\Elements\Bootstrapper\VistaDialog*.cs;..\Nullstrap.App\UI\Elements\Bootstrapper\Base\WinFormsDialogBase.cs;..\Nullstrap.App\Integrations\RiShade\RiShadeWgc.cs;..\Nullstrap.App\Integrations\RiShade\RiShadeWinRtStubs*.cs" />
		<Page Visible="false" Include="..\Nullstrap.App\**\*.xaml" Exclude="..\Nullstrap.App\obj\**;..\Nullstrap.App\obj-*\**;..\Nullstrap.App\bin\**;..\Nullstrap.App\bin-*\**;..\Nullstrap.App\App.xaml;..\Nullstrap.App\UI\Elements\RobloxWeb\**;..\Nullstrap.App\UI\Elements\Controls\InlineVideoPlayer.xaml;..\Nullstrap.App\UI\Elements\ContextMenu\Web\**;..\Nullstrap.App\UI\Elements\About\MainWindow.xaml;..\Nullstrap.App\UI\Elements\Installer\MainWindow.xaml" />
		<Page Remove="..\Nullstrap.App\UI\Elements\Installer\Pages\ChannelPage.xaml" />
		<Page Include="Xaml\AboutMainWindow.xaml" />
		<Page Include="Xaml\InstallerMainWindow.xaml" Condition="!$(RuntimeIdentifier.StartsWith('linux')) And !$(RuntimeIdentifier.StartsWith('osx'))" />
		<Page Include="Xaml\InstallerMainWindow.Linux.xaml" Condition="$(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('osx'))" />
		<Page Include="Xaml\InstallerChannelPage.xaml" Condition="!$(RuntimeIdentifier.StartsWith('linux')) And !$(RuntimeIdentifier.StartsWith('osx'))" />
		<Page Include="Xaml\InstallerChannelPage.Linux.xaml" Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
		<Page Include="Xaml\InstallerChannelPage.MacOS.xaml" Condition="$(RuntimeIdentifier.StartsWith('osx'))" />
		<ApplicationDefinition Visible="false" Include="..\Nullstrap.App\App.xaml">
			<Link>App.xaml</Link>
		</ApplicationDefinition>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Visible="false" Include="..\Nullstrap.App\Resources\**\*" Exclude="..\Nullstrap.App\Resources\**\*.cs;..\Nullstrap.App\Resources\**\*.ico;..\Nullstrap.App\Resources\**\*.jpg;..\Nullstrap.App\Resources\**\*.png;..\Nullstrap.App\Resources\Fonts\Montserrat-*.ttf;..\Nullstrap.App\Resources\Fonts\NotoSansThai-*.ttf;..\Nullstrap.App\Resources\Fonts\Rubik-*.ttf">
			<Link>Resources\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</EmbeddedResource>
		<EmbeddedResource Visible="false" Include="..\Nullstrap.App\Resources\Mods\Cursor\**\*.png">
			<Link>Resources\Mods\Cursor\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</EmbeddedResource>
		<EmbeddedResource Visible="false" Include="..\Nullstrap.App\Properties\*.resx">
			<Link>Properties\%(Filename)%(Extension)</Link>
		</EmbeddedResource>
		<EmbeddedResource Visible="false" Include="..\Nullstrap.App\UI\Style\*.xshd">
			<Link>UI\Style\%(Filename)%(Extension)</Link>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Resource Visible="false" Include="..\Nullstrap.App\Nullstrap.ico">
			<Link>Nullstrap.ico</Link>
		</Resource>
		<Resource Visible="false" Include="..\Nullstrap.App\Nullstrap.png">
			<Link>Nullstrap.png</Link>
		</Resource>
		<Resource Visible="false" Include="..\Nullstrap.App\Resources\RobloxVngIcon.png">
			<Link>Resources\RobloxVngIcon.png</Link>
		</Resource>
		<Resource Visible="false" Include="..\Nullstrap.App\Resources\Checkmark.ico;..\Nullstrap.App\Resources\CrossMark.ico;..\Nullstrap.App\Resources\Icon2008.ico;..\Nullstrap.App\Resources\Icon2011.ico;..\Nullstrap.App\Resources\Icon2017.ico;..\Nullstrap.App\Resources\Icon2019.ico;..\Nullstrap.App\Resources\Icon2022.ico;..\Nullstrap.App\Resources\IconEarly2015.ico;..\Nullstrap.App\Resources\IconLate2015.ico;..\Nullstrap.App\Resources\IconNullstrap.ico;..\Nullstrap.App\Resources\Erik.png;..\Nullstrap.App\Resources\RobloxFace.png;..\Nullstrap.App\Resources\RobloxPlayerIcon.png;..\Nullstrap.App\Resources\RobloxStudioIcon.png;..\Nullstrap.App\Resources\SoberIcon.png;..\Nullstrap.App\Resources\RosemaryIcon.png;..\Nullstrap.App\Resources\VinegarIcon.png">
			<Link>Resources\%(Filename)%(Extension)</Link>
		</Resource>
		<Resource Visible="false" Include="..\Nullstrap.App\Resources\BootstrapperStyles\ByfronDialog\ByfronLogoDark.jpg;..\Nullstrap.App\Resources\BootstrapperStyles\ByfronDialog\ByfronLogoLight.jpg;..\Nullstrap.App\Resources\BootstrapperStyles\ByfronDialog\Matt.png">
			<Link>Resources\BootstrapperStyles\ByfronDialog\%(Filename)%(Extension)</Link>
		</Resource>
		<Resource Visible="false" Include="..\Nullstrap.App\Resources\CommunityMods\*.png">
			<Link>Resources\CommunityMods\%(Filename)%(Extension)</Link>
		</Resource>
		<Resource Visible="false" Include="..\Nullstrap.App\Resources\Fonts\NotoSansThai-VariableFont_wdth,wght.ttf;..\Nullstrap.App\Resources\Fonts\Rubik-VariableFont_wght.ttf">
			<Link>Resources\Fonts\%(Filename)%(Extension)</Link>
		</Resource>
		<Resource Visible="false" Include="..\..\external\wpfui\src\Wpf.Ui\Fonts\Source\FluentSystemIcons-Regular.ttf">
			<Link>Resources\Fonts\SymbolIcons\FluentSystemIcons-Regular.ttf</Link>
		</Resource>
		<Resource Visible="false" Include="..\..\external\wpfui\src\Wpf.Ui\Fonts\Source\FluentSystemIcons-Filled.ttf" Condition="$(RuntimeIdentifier.StartsWith('osx'))">
			<Link>Resources\Fonts\SymbolIcons\FluentSystemIcons-Filled.ttf</Link>
		</Resource>
		<Resource Visible="false" Include="..\Nullstrap.App\Resources\MessageBox\Error.png;..\Nullstrap.App\Resources\MessageBox\Information.png;..\Nullstrap.App\Resources\MessageBox\Question.png;..\Nullstrap.App\Resources\MessageBox\Warning.png">
			<Link>Resources\MessageBox\%(Filename)%(Extension)</Link>
		</Resource>
		<Resource Visible="false" Include="..\Nullstrap.App\Resources\Flags\*.png">
			<Link>Resources\Flags\%(Filename)%(Extension)</Link>
		</Resource>
		<Resource Visible="false" Include="..\Nullstrap.App\Resources\Mods\Cursor\**\*.png">
			<Link>Resources\Mods\Cursor\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Resource>
		<Resource Visible="false" Include="..\Nullstrap.App\Resources\AppImages\*.png">
			<Link>Resources\AppImages\%(Filename)%(Extension)</Link>
		</Resource>
	</ItemGroup>

	<ItemGroup>
		<RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64'" />
		<RuntimeHostConfigurationOption Include="Switch.System.Windows.Controls.Text.UseAdornerForTextboxSelectionRendering" Value="true" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AvalonEdit" Version="6.3.1.120" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
		<PackageReference Include="Markdig" Version="1.4.1" />
		<PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64'" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.4" />
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.363">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NAudio" Version="3.2.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
		<PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
		<PackageReference Include="NVorbis" Version="0.10.5" />
		<PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
		<PackageReference Include="securifybv.ShellLink" Version="0.1.0" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.12" />
		<PackageReference Include="System.Management" Version="10.0.13" />
		<PackageReference Include="System.Resources.Extensions" Version="10.0.13" />
		<PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
		<PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
		<PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
		<PackageReference Include="Vortice.DXGI" Version="3.8.3" />
		<PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
		<PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
		<PackageReference Include="Openize.Drako" Version="26.2.0" />
		<PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
		<PackageReference Include="Tmds.DBus" Version="0.95.1" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Visible="false" Include="..\Nullstrap.App\NativeMethods.txt" Link="NativeMethods.txt" />
		<ProjectReference Include="..\Nullstrap.Core\Nullstrap.Core.csproj" />
		<ProjectReference Include="..\Nullstrap.Platform.Abstractions\Nullstrap.Platform.Abstractions.csproj" />
		<ProjectReference Include="..\Nullstrap.Platform.Linux\Nullstrap.Platform.Linux.csproj" />
		<ProjectReference Include="..\Nullstrap.Platform.MacOS\Nullstrap.Platform.MacOS.csproj" />
		<ProjectReference Include="..\..\external\wpfui\src\Wpf.Ui\Wpf.Ui.Cross.csproj" />
