<UserControl xmlns:resources="clr-namespace:Nullstrap.Resources" x:Class="Nullstrap.UI.Elements.Controls.BootstrapperImportControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Nullstrap.UI.Elements.Controls" xmlns:platform="clr-namespace:Nullstrap.UI" Visibility="{x:Static platform:PlatformFeatureVisibility.NotMacOS}" Unloaded="OnUnloaded">
  <controls:OptionControl Header="{resources:Loc Ui_Misc2_ApplyFrom}" Visibility="{x:Static platform:PlatformFeatureVisibility.NotMacOS}">
    <StackPanel Orientation="Horizontal">
      <ComboBox Width="150" Margin="0,0,8,0" SelectedIndex="0">
        <ComboBoxItem Content="Bloxstrap" Tag="Bloxstrap" />
        <ComboBoxItem Content="Fishstrap" Tag="Fishstrap" />
      </ComboBox>
      <Button Content="{resources:Loc Mtu_Apply}" Click="ApplyFrom_Click" />
    </StackPanel>
  </controls:OptionControl>
</UserControl>
