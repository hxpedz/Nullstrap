<Project>

	<PropertyGroup>
		<NullstrapVersion>1.1.3.8</NullstrapVersion>
	</PropertyGroup>

	<PropertyGroup>
		<RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
	</PropertyGroup>

	<PropertyGroup Condition="'$(NullstrapLinuxPackagingRoot)' != ''">
		<BaseOutputPath>$(NullstrapLinuxPackagingRoot)bin/$(MSBuildProjectName)/</BaseOutputPath>
		<BaseIntermediateOutputPath>$(NullstrapLinuxPackagingRoot)obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
		<DefaultItemExcludes>$(DefaultItemExcludes);bin/**;bin-*/**;bin-cross/**;obj/**;obj-*/**</DefaultItemExcludes>
	</PropertyGroup>

	<PropertyGroup Condition="'$(NullstrapLinuxPackagingRoot)' != '' And $(MSBuildProjectName.StartsWith('Nullstrap.Cross'))">
		<BaseOutputPath>$(NullstrapLinuxPackagingRoot)bin/Nullstrap.Cross/</BaseOutputPath>
		<BaseIntermediateOutputPath>$(NullstrapLinuxPackagingRoot)obj/Nullstrap.Cross/</BaseIntermediateOutputPath>
	</PropertyGroup>

	<PropertyGroup>
		<Version Condition="'$(Version)' == ''">$(NullstrapVersion)</Version>
		<FileVersion>$(Version)</FileVersion>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<InformationalVersion>$(Version)</InformationalVersion>
	</PropertyGroup>

</Project>
